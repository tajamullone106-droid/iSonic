# ============================
#     MUSIC BOT CONFIG
# ============================

# Get these from https://my.telegram.org
API_ID=12345678
API_HASH=your_api_hash_here

# Get this from @BotFather
BOT_TOKEN=123456:ABC-your-bot-token

# Assistant account session string (voice chat join ke liye)
# Generate karne ke liye: python3 generate_session.py
SESSION_STRING=your_pyrogram_session_string_here

# MongoDB (free cluster: https://cloud.mongodb.com)
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/musicbot

# Telegram numeric user_id jo bot ka OWNER hoga
OWNER_ID=123456789

# Bot ka support group / channel username (bina @ ke), optional
SUPPORT_GROUP=your_support_group
SUPPORT_CHANNEL=your_support_channel

# Bot ka display name (start message me use hoga)
BOT_NAME=Melody
